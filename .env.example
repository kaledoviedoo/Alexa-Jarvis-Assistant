# ============================================================================
#  Configuración de Jarvis
#
#  Copia este archivo como  .env  (sin el .example) y ajusta los valores.
#  El archivo .env NO debe subirse nunca a GitHub: contiene el ID de tu skill.
# ============================================================================

# ---------------------------------------------------------------------------
# SEGURIDAD  (lo más importante de configurar)
# ---------------------------------------------------------------------------
# ID de tu skill, tal cual aparece en la consola de desarrollador de Alexa,
# en Build > Endpoint (o en la lista de skills, bajo "Ver ID").
ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# Verificación criptográfica de la firma de Amazon.
# Déjalo en true siempre. Ponlo en false SOLO mientras pruebas con curl
# en local, y vuelve a ponerlo en true antes de usarlo con Alexa de verdad.
JARVIS_VERIFICAR_FIRMA=true

# Nombre de invocacion de la skill, tal cual esta en la consola.
# Amazon no admite nombres de una sola palabra salvo marca propia,
# asi que tiene que ser de dos o mas. Jarvis lo recorta del comando
# porque Alexa a veces lo deja dentro del slot.
ALEXA_INVOCATION_NAME=mi asistente

# ---------------------------------------------------------------------------
# MODELOS POR MODO   (perfilado para RTX 3050 de 6 GB)
# ---------------------------------------------------------------------------
# Modo normal: ligero y siempre caliente. ~2,4 GB de VRAM.
# Elegido con banco_modelos.py: acierta como llama3.2:3b y, cuando falla,
# no hace nada en vez de hacer algo mal.
JARVIS_MODELO_NORMAL=qwen2.5:3b

# Modo dedicado: razona mejor. ~4.7 GB de VRAM, entra justo en 6 GB.
# Si te quedas sin memoria, baja a  llama3.1:8b-instruct-q4_0  o a  qwen2.5:3b
JARVIS_MODELO_DEDICADO=qwen2.5:7b-instruct-q4_K_M

# Modo gaming: corre en CPU, así que conviene el modelo más pequeño.
JARVIS_MODELO_GAMING=qwen2.5:3b

# Modo con el que arranca Jarvis al encender el equipo.
JARVIS_MODO_INICIAL=normal

# ---------------------------------------------------------------------------
# TIEMPOS
# ---------------------------------------------------------------------------
# Segundos que Jarvis espera al modelo antes de responder "lo estoy procesando".
# Alexa corta a los ~8 s, así que no subas esto de 7.
JARVIS_PRESUPUESTO_SEGUNDOS=6.5

# ---------------------------------------------------------------------------
# RUTAS  (opcionales: se detectan solas)
# ---------------------------------------------------------------------------
# Descomenta si tu Escritorio está en OneDrive y Jarvis no lo encuentra.
# JARVIS_ESCRITORIO=C:\Users\TU_USUARIO\OneDrive\Escritorio

# Descomenta si Comet está instalado en una ruta distinta a la habitual.
# JARVIS_COMET_EXE=C:\Users\TU_USUARIO\AppData\Local\Programs\Comet\Comet.exe

# Motor de búsqueda. {q} se reemplaza por la consulta.
# JARVIS_MOTOR_BUSQUEDA=https://www.perplexity.ai/search?q={q}
# JARVIS_MOTOR_BUSQUEDA=https://www.google.com/search?q={q}

# ---------------------------------------------------------------------------
# TÚNEL (ngrok)
# ---------------------------------------------------------------------------
# Tu dominio ESTÁTICO de ngrok. El plan gratuito incluye uno.
# Reclámalo en https://dashboard.ngrok.com/domains
#
# Es imprescindible que sea estático: con un túnel efímero la URL cambia en
# cada arranque y habría que reconfigurar la skill de Alexa cada vez.
#
# Lo rellena solo el script  scripts\configurar_ngrok.ps1
JARVIS_NGROK_URL=https://tu-dominio-estatico.ngrok-free.app

# Llave de las rutas locales (/probar y el detalle de /salud).
# Sin ella esas rutas responden 404. Genera una con:
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN_LOCAL=

# Puerto local donde escucha Jarvis.
JARVIS_PUERTO=8000

# ---------------------------------------------------------------------------
# TU
# ---------------------------------------------------------------------------
# Como te llama Jarvis al saludarte ("Hola Ana"). Vacio: sin nombre.
JARVIS_NOMBRE_USUARIO=

# ---------------------------------------------------------------------------
# AVISOS Y RUTINAS (Fase 5)
# ---------------------------------------------------------------------------
# Notificaciones de Windows cuando termina algo de fondo. 0 para apagarlas.
JARVIS_AVISOS=1
# Las rutinas se editan en %USERPROFILE%\.jarvis\rutinas.yaml

# ---------------------------------------------------------------------------
# VOZ SIN ALEXA (Fase 6.2)   instala con: scripts\instalar_voz.ps1
# ---------------------------------------------------------------------------
# 0 para no registrar el atajo de teclado.
JARVIS_VOZ_LOCAL=1
# Atajo para hablarle: se pulsa, se habla y se hace una pausa.
JARVIS_VOZ_ATAJO=ctrl+alt+j
# Modelo de Whisper: tiny, base, small (recomendado) o medium (mas lento).
JARVIS_WHISPER_MODELO=small
# Voz de Piper: https://huggingface.co/rhasspy/piper-voices
JARVIS_VOZ_PIPER=es_MX-claude-high
